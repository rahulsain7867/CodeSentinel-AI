# ==============================================================================
# CodeSentinel AI — Configuration
# 24/7 Intelligent Code Reviewer
# ==============================================================================
# Copy this file to .env and update with your values.
# NEVER commit your actual .env file with real credentials.

# ==============================================================================
# GOOGLE CLOUD CONFIGURATION
# ==============================================================================

# Your Google Cloud Project ID (required for Vertex AI and Firestore).
GOOGLE_CLOUD_PROJECT=your-project-id

# Google Cloud region/location for deployments.
GOOGLE_CLOUD_LOCATION=us-central1

# ==============================================================================
# MODEL CONFIGURATION
# ==============================================================================

# Use Vertex AI (true) or Google AI Studio (false) for models.
# For local development without GCP, set to false and provide GOOGLE_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=false

# API Key for Google AI Studio (required if GOOGLE_GENAI_USE_VERTEXAI=false).
# Get one from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Model for fast analysis tasks.
WORKER_MODEL=gemini-2.5-flash

# Advanced model for nuanced feedback generation.
CRITIC_MODEL=gemini-2.5-pro

# ==============================================================================
# CODESENTINEL AI CONFIGURATION
# ==============================================================================

# Developer identifier for tracking review history.
CODESENTINEL_DEVELOPER_ID=default_developer

# Firestore collection name for storing review history.
# If Firestore is not available, falls back to in-memory storage.
FIRESTORE_COLLECTION=codesentinel_reviews

# ==============================================================================
# CLOUD RUN - DATABASE CONFIGURATION (OPTIONAL)
# ==============================================================================
# These are only needed for Cloud Run deployment with persistent sessions.

CLOUD_SQL_INSTANCE_NAME=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ==============================================================================
# AGENT ENGINE CONFIGURATION (OPTIONAL)
# ==============================================================================
# Only needed for Vertex AI Agent Engine deployment.

AGENT_ENGINE_ID=
STAGING_BUCKET=gs://your-project-staging

# ==============================================================================
# ARTIFACT STORAGE (OPTIONAL)
# ==============================================================================

ARTIFACT_BUCKET=codesentinel-ai-artifacts

# ==============================================================================
# APPLICATION PARAMETERS
# ==============================================================================

PASSING_SCORE_THRESHOLD=0.8
STYLE_WEIGHT=0.3
TEST_WEIGHT=0.5
STRUCTURE_WEIGHT=0.2
MAX_GRADING_ATTEMPTS=3

# ==============================================================================
# LOGGING
# ==============================================================================

LOG_LEVEL=INFO
DEBUG_MODE=false